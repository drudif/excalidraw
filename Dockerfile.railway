# Dockerfile usado no deploy do Railway.
#
# Deliberadamente sem nenhuma sintaxe que dependa de recurso opcional do
# BuildKit. O Dockerfile do upstream usa `--platform=${BUILDPLATFORM}` no FROM e
# `RUN --mount=type=cache`; no builder do Railway o build morre em segundos sem
# escrever uma linha de log, o que torna o erro invisivel. Aqui: instrucoes
# simples, sem --platform, sem --mount, sem digest pinado.
#
# Arquivo separado pra nao dar conflito ao sincronizar com o upstream.

FROM node:24 AS build

WORKDIR /opt/node_app

COPY . .

# nao ignorar dependencias opcionais:
# Error: Cannot find module @rollup/rollup-linux-x64-gnu
RUN yarn --frozen-lockfile --network-timeout 600000

ARG NODE_ENV=production

RUN yarn build:app:docker

FROM nginx:stable-alpine-slim

# htpasswd, pra gerar o arquivo de senha no boot
RUN apk add --no-cache apache2-utils

COPY --from=build /opt/node_app/excalidraw-app/build /usr/share/nginx/html

# tira o default.conf da imagem e poe o nosso no lugar
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/excalidraw.conf

# a imagem oficial executa tudo que estiver em /docker-entrypoint.d antes de
# subir o nginx; e la que a senha e gerada a partir de APP_PASSWORD
COPY docker/40-htpasswd.sh /docker-entrypoint.d/40-htpasswd.sh
RUN chmod +x /docker-entrypoint.d/40-htpasswd.sh

EXPOSE 80
